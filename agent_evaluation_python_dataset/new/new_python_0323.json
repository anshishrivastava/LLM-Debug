  "instruction": "Prefixesdivby5",
  "output": "    def prefixesDivBy5(self, nums: List[int]) -> List[bool]:\n        val = 0\n        for i in range(len(nums)):\n            val = ((val << 1) + nums[i]) % 5\n            nums[i] = val == 0\n        return nums",
