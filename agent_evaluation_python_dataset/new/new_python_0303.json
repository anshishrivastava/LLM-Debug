  "output": "def all_words_are_unique(words: List[str]) -> Tuple[bool, Set[str]]:\n    unique = {}\n    for word in words:\n        if word in unique:\n            return False, set()\n        else:\n            unique[word] = True\n    return True, set(*unique.keys())",
