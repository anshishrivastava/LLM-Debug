  "output": "    def get_group_name(job_data: JobData) -> str:\n        group_name = f\"/{job_data.job_name}\"\n        for key in sorted(job_data.categories.keys()):\n            group_name += f\"/{key}={job_data.categories[key]}\"\n        return group_name",
