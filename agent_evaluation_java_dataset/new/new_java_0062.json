{
  "instruction": "Remove Duplicates",
  "output": "    public int removeDuplicates(int[] nums) {\n        int j=1;\n        for(int i=1; i<nums.length; i++){\n            if(nums[i] != nums[i-1]){\n                nums[j]=nums[i];\n                j++;\n            }\n        }\n        return j;\n    }",
