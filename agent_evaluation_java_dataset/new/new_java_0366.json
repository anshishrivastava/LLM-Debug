{
  "instruction": "Find Maximum",
  "output": "    public int findMaximum(int[] arr) {\n        int low = 0, high = arr.length - 1;\n        while (low < high) {\n            int mid = (low + high) / 2;\n            if (arr[mid] < arr[mid + 1])\n                low = mid + 1;\n            else\n                high = mid;\n        }\n        return arr[low];\n    }",
