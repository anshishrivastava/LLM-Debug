{
  "instruction": "Swap Pairs",
  "output": "    public ListNode swapPairs(ListNode head) {\n        if(head==null || head.next==null) return head;\n        ListNode dummy=head;\n        ListNode temp=dummy.next;\n        dummy.next=swapPairs(dummy.next.next);\n        temp.next=dummy;\n        return temp;\n    }",
