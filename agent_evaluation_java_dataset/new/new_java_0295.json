{
  "instruction": "Largest Perimeter",
  "output": "    public int largestPerimeter(int[] nums) {\n        Arrays.sort(nums);\n        for (int i = nums.length - 1; i >= 2; i--)\n            if (nums[i - 1] + nums[i - 2] > nums[i])\n                return nums[i] + nums[i - 1] + nums[i - 2];\n        return 0;\n    }",
