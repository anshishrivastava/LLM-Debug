{
  "instruction": "Remove Duplicates",
  "output": "    public int removeDuplicates(int[] nums) {\n        int n=nums.length;\n         int c=1;\n        for(int i=1;i<n;i++){\n           \n            if(nums[i]!=nums[i-1]){\n            nums[c]=nums[i];\n            c++;\n            }\n          \n        }\n          return c;\n    }",
