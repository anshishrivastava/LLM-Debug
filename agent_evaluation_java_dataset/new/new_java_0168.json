  "output": "    public int arrayPairSum(int[] nums) {\n        \n        Arrays.sort(nums);\n\n        int sum = 0;\n        for(int i = 0; i < nums.length; i = i+2){\n            sum += nums[i];\n        }\n\n        return sum;\n\n    }",
