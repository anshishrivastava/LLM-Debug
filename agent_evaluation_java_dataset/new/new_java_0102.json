  "output": "    public static int sumOfTree(TreeNode node){\n        int left = 0,right=0;\n        if(node.left!=null)\n            left = sumOfTree(node.left);\n        if(node.right!=null)\n            right = sumOfTree(node.right);\n        return node.val+left+right;\n    }",
