  "output": "    public boolean ContainsDuplicate(int[] nums){\r\n        HashSet<Integer> set = new HashSet<>();\r\n        for (Integer num : nums) {\r\n            if (!set.add(num)) {\r\n                return true;\r\n            }\r\n        }\r\n        return false;\r\n    }\r",
