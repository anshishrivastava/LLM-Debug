{
  "instruction": "Remove Duplicates",
  "output": "        public int removeDuplicates(int[] nums) {\n          int i =0;\n          for(int j=0;j<nums.length;j++){\n            if(nums[j]!= nums[i]){\n                i++;\n                nums[i] = nums[j];\n            }\n          }\n          return i+1;\n    }",
