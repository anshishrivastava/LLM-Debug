  "instruction": "Move Zeroes",
  "output": "    public void moveZeroes(int[] nums) {\n        int i = 0;\n        for(int j = 0; j<nums.length; j++){\n            if(nums[j] != 0){\n                nums[i] = nums[j];\n                i++;\n            }\n        } \n\n        while( i < nums.length){\n            nums[i] = 0;\n            i++;\n        }\n    }",
