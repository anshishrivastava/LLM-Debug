{
  "instruction": "Remove Element",
  "output": "    public int removeElement(int[] nums, int val) {\n       int n = nums.length;\n       int j = 0;\n       for(int i=0;i<n;i++){\n          if(nums[i]!= val){\n            nums[j] = nums[i];\n            j++;\n          }\n       }\n       return j;\n    }",
