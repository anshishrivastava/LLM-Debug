  "output": "    public boolean isPalindrome(int x) \n    {\n        int n=x;int s=0;int a;\n      if(x<0)\n      return false;\n      else\n      {\n          while(n!=0)\n          {\n              a=n%10;\n              s=s*10+a;\n              n=n/10;\n          }\n          if(x==s)\n          return true;\n          else\n          return false;\n      }  \n    }",
