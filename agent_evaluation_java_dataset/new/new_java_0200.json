{
  "instruction": "Missing Number",
  "output": "    public int missingNumber(int[] nums) {\n        int n = nums.length;\n\n        int expectedSum = (n*(n+1))/2;\n\n        int sum = 0;\n\n        for(int i=0; i<n; i++){\n            sum += nums[i];\n        }\n\n        int missingNumber = expectedSum - sum;\n\n        return missingNumber;\n    }",
