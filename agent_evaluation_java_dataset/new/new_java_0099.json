{
  "instruction": "Find Maximum X O R",
  "output": "    public int findMaximumXOR(int[] nums) {\n        Trie trie=new Trie();\n        int n=nums.length;\n        for(int i=0;i<n;i++){\n            trie.insert(nums[i]);\n        }\n        int max1=0;\n        for(int i=0;i<n;i++){\n            max1=Math.max(max1,trie.getMax(nums[i]));\n        }\n        return max1;\n    }",
