{
  "instruction": "Max Sub Array",
  "output": "    public int maxSubArray(int[] nums) {\n        int sum=0;\n        int mx=Integer.MIN_VALUE;\n        int j=0;\n\n        while(j<nums.length){\n            sum+=nums[j];\n           mx=Math.max(mx,sum);\n           \n            if(sum<0 ){\n                sum=0;\n                 \n            }\n            j++;\n            \n        }\n        return mx;\n    }",
