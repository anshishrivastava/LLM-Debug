{
  "instruction": "Remove Duplicates",
  "output": "    public int removeDuplicates(int[] nums) {\n        if (nums.length == 0)\n            return 0;\n\n        int k = 0;\n        for (int i = 1; i < nums.length; i++) {\n            if (nums[i] != nums[k]) {\n                k++;\n                nums[k] = nums[i];\n            }\n        }\n        return k + 1;\n    }",
