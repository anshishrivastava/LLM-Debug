  "instruction": "Next Permutation",
  "output": "    public void nextPermutation(int[] nums) {\n      int n=nums.length;\n      int i=n-2;\n      while(i>=0&& nums[i]>=nums[i+1])\n      {\n        i--;\n      }\n\n      if(i>=0)\n      {\n        int j=n-1;\n        while(nums[j]<=nums[i])\n        {\n            j--;\n        }\n        swap(nums,j,i);\n      }\n\n      reverse(nums,i+1);\n    }",
