  "output": "    public boolean isPalindrome(int x) {\n        int actual = x;\n        int rev=0;\n        while(x>0){\nrev = rev*10+(x%10);\nx=x/10;\n        }\n        if(actual==rev){\n            return true;\n        }\n        return false;\n    }",
