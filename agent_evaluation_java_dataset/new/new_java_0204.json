  "output": "    public boolean uniqueOccurrences(int[] arr) {\n     int[] freq = new int[2001];\n\n     for(int num : arr){\n        freq[num+1000]++;\n     }\n\n     Arrays.sort(freq);\n\n     for(int i = 1; i < 2001; i++){\n        if(freq[i] != 0 && freq[i] == freq[i-1]){\n            return false;\n        }\n     }\n\n    \n     return true;\n    }",
