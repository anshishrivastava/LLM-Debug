{
  "instruction": "Largest Perimeter",
  "output": "  public int largestPerimeter(int[] nums) {\n    Arrays.sort(nums);\n\n    for (int i = nums.length - 1; i > 1; --i)\n      if (nums[i - 2] + nums[i - 1] > nums[i])\n        return nums[i - 2] + nums[i - 1] + nums[i];\n\n    return 0;\n  }",
