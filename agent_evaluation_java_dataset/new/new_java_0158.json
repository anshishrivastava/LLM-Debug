{
  "instruction": "Remove Duplicates",
  "output": "    public int removeDuplicates(int[] nums) {\n        if(nums.length==0)  return 0;\n        int size=1;\n        for(int i=1;i<nums.length;i++){\n            if(nums[i]!=nums[size-1]){\n                nums[size]=nums[i];\n                size++;\n            }\n        }\n        return size;\n    }",
