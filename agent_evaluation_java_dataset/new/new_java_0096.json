  "output": "    \n    public boolean startsWith(String prefix) {\n        Node node=root;\n        for(char ch:prefix.toCharArray()){\n            if(!node.containsKey(ch)){\n                return false;\n            }\n            node=node.get(ch);\n        }\n        return true;\n    }",
