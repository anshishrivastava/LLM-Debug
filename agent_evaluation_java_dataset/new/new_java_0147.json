{
  "instruction": "Remove Element",
  "output": "    public int removeElement(int[] nums, int val) {\n        int l = 0;\n        int p = 0;\n\n        int n = nums.length;\n\n        while(p < n) {\n            if(nums[p] != val) {\n                nums[l++] = nums[p++];\n            } else {\n                p++;\n            }\n        }\n\n        return l;\n    }",
