  "output": "    public static boolean containsDuplicate(int[] arr){\n        for (int i=0; i<arr.length; i++){\n            for (int j=i+1; j< arr.length; j++){\n                if (arr[i] == arr[j]){\n                    return true;\n                }\n            }\n        }\n        return false;\n    }",
