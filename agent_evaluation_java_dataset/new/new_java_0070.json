  "instruction": "Climb Stairs",
  "output": "    public int climbStairs(int n) {\n        int p2 = 1;\n        int p1 = 1;\n        for(int i=2;i<=n;i++){\n            int curr = p2+p1;\n            p2=p1;\n            p1=curr;\n        }\n        return p1;\n    }",
