  "output": "    public boolean isPalindrome(int x) {\n        int rev=0;\n        int org=x;\n        while(x>0){\n            rev=rev*10+(x%10);\n            x=x/10;\n        }\n        if(rev==org){\n            return true;\n        }\n    return false;\n    }",
