{
  "instruction": "Is Palindrome",
  "output": "    public boolean isPalindrome(int x) {\n        int temp=x;\n        int reverse=0;\n        while(x>0){\n            int digit=x%10;\n            reverse=(reverse *10)+digit;\n            x/=10;\n        }\n        return reverse==temp;\n    }",
