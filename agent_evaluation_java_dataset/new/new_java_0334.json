  "output": "    public boolean isPalindrone(int i,int j,String s){\n        int left=i;\n        int right=j-1;\n        while(left<right){\n            if(s.charAt(left)!=s.charAt(right)){\n                return false;\n            }\n            left++;right--;\n           \n        }\n         return true;\n    }",
