  "output": "    public boolean threeConsecutiveOdds(int[] arr) {\n        int count=0;\n        for(int i=0;i<arr.length;i++){\n            \n            if(arr[i]%2!=0){\n                count++;\n            }else{\n                count=0;\n            }\n\n            if(count==3){\n                return true;\n            }\n        }\n\n        return false;\n    }",
