{
  "instruction": "Diagonal Sum Difference",
  "output": "        int diagonalSumDifference(int N, int[][] Grid) {\n            // code here\n            int k=Grid.length-1;\n            for(int i=0;i<N;i++){\n                right+=Grid[i][k-i];\n\n                for(int j=0;j<=i;j++){\n                    if(i==j ){\n                        left+=Grid[i][j] ;\n\n\n                    }\n                }\n\n            }\n            return Math.abs(left-right);\n        }",
